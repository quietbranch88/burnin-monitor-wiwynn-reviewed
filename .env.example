# Copy to .env: cp .env.example .env (PowerShell: Copy-Item .env.example .env)
# The values work for a local demo. Change the passwords and JWT_SECRET before any shared deployment.

# ---- MariaDB 11.7 ----
MARIADB_ROOT_PASSWORD=change-me-root-password
MARIADB_DATABASE=monitor
MARIADB_USER=monitor
# Use letters, digits, '-' or '_': the password is placed in the connection URL without escaping.
MARIADB_PASSWORD=change-me-db-password

# ---- API ----
# At least 32 characters. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# Token lifetime: one 8-hour shift, so a station showing the live page is not signed out mid-shift.
# Logging out ends every token of that user at once.
JWT_EXPIRE_MINUTES=480
LOG_LEVEL=INFO

# SQLAlchemy connection pool: connections kept open, and extra connections allowed under load.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Seconds a request waits for a free connection before the API answers 503.
# Keep it below the frontend's 15 s timeout.
DB_POOL_TIMEOUT=10
# Seconds before a connection is closed and reopened; below MariaDB's idle timeout.
DB_POOL_RECYCLE=1800

# Real-time generator: every server reports every sensor once per interval.
# Each server has 50 sensors in the categories below (8 GPUs, 16 memory modules, ...),
# so 20 servers are 1,000 readings/s and one burn-in line of 200 servers is 10,000/s.
REALTIME_SERVERS=20
REALTIME_INTERVAL_SECONDS=1
# Comma-separated category:threshold pairs: the first values, which an admin can change later.
# A reading past its threshold is an alert: above it, or below it for the metrics in
# REALTIME_ALERT_BELOW (a failing fan slows down).
REALTIME_THRESHOLDS=chamber_temp:45,cpu_temp:90,gpu_temp:85,dimm_temp:85,nvme_temp:70,fan_rpm:3000,power_w:2700
REALTIME_ALERT_BELOW=fan_rpm
# First values of three admin settings: a reading this close to its limit (in %) is a warning;
# the interface language for every station (en or zh); and the plant's IANA time zone, in which
# every station shows and enters times (the database and API always use UTC).
REALTIME_WARNING_PERCENT=90
DISPLAY_LANGUAGE=en
DISPLAY_TZ=Asia/Taipei
# The batch writer writes every REALTIME_FLUSH_INTERVAL_SECONDS,
# or sooner when REALTIME_FLUSH_BATCH_SIZE readings are waiting.
REALTIME_FLUSH_INTERVAL_SECONDS=10
REALTIME_FLUSH_BATCH_SIZE=1000
# Readings kept in memory if the database is unreachable, before the oldest are dropped.
REALTIME_MAX_PENDING=500000
# Number of 5,000-reading chunks written at the same time, each on its own connection (1-8).
REALTIME_WRITE_CONCURRENCY=4
# Raw readings older than this many hours are deleted. Per-minute statistics are kept.
REALTIME_RETENTION_HOURS=12
# System logs older than this many days are deleted.
LOG_RETENTION_DAYS=14

# ---- Demo accounts created on first start ----
# Changing these after the first start has no effect: existing accounts are kept.
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_PASSWORD=User@12345
SEED_VIEWER_PASSWORD=Viewer@12345

# ---- Published ports ----
# Bound to this machine only. To reach the demo from other machines, set a real JWT_SECRET
# and the passwords above first, then use e.g. API_PORT=0.0.0.0:8000 and FRONTEND_PORT=0.0.0.0:8501.
API_PORT=127.0.0.1:8000
FRONTEND_PORT=127.0.0.1:8501
